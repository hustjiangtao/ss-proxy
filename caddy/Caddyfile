:80 {
  redir http://127.0.0.1
}

127.0.0.1:443, localhost:443 {
  respond 403 {
    close
  }
}

:443, {$DOMAIN} {
  tls {$EMAIL}
  route {
    forward_proxy {
      basic_auth <username> <password>
      hide_ip
      hide_via
      probe_resistance
    }
    reverse_proxy https://www.bing.com {
        header_up Host {upstream_hostv4}
    }
  }
}

